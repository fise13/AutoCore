rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------
    // Helpers
    // -------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function userRef() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userDoc() {
      return isSignedIn() && exists(userRef()) ? get(userRef()).data : null;
    }

    function tokenCompanyId() {
      return isSignedIn() ? request.auth.token.companyId : null;
    }

    function tokenRole() {
      return isSignedIn() ? request.auth.token.role : null;
    }

    function userCompanyId() {
      return tokenCompanyId() != null && tokenCompanyId() != ""
        ? tokenCompanyId()
        : (userDoc() != null ? userDoc().companyId : null);
    }

    function userRole() {
      return tokenRole() != null ? tokenRole() : (userDoc() != null ? userDoc().role : null);
    }

    function inRole(allowed) {
      let role = userRole();
      return role != null && role in allowed;
    }

    function isOwnerOrAdmin() {
      return inRole(['owner', 'admin']);
    }

    function canWriteFinancial() {
      // Финансы может писать любой участник своей компании.
      // Это снимает блокировки, когда role/claims ещё не успели обновиться.
      return hasCompany();
    }

    function canWriteFinancialForCompany(companyId) {
      return companyId != null
        && (
          (canWriteFinancial() && canAccessCompanyDoc(companyId))
          || isOwnerOfCompany(companyId)
        );
    }

    function hasCompany() {
      let cid = userCompanyId();
      return isSignedIn() && cid != null && cid != "";
    }

    function sameCompany(companyId) {
      return hasCompany() && companyId != null && companyId == userCompanyId();
    }

    function sameCompanyDoc() {
      return sameCompany(resource.data.companyId);
    }

    function sameCompanyRequest() {
      return sameCompany(request.resource.data.companyId);
    }

    function companyOwner(companyId) {
      let cref = /databases/$(database)/documents/companies/$(companyId);
      return companyId != null && companyId != "" && exists(cref) ? get(cref).data.ownerId : null;
    }

    function isOwnerOfCompany(companyId) {
      return isSignedIn() && companyOwner(companyId) == request.auth.uid;
    }

    function canReadByCompanyDoc(companyId) {
      // Fallback for cases when custom claims are stale but users/{uid}.companyId is already updated.
      return isSignedIn()
        && companyId != null
        && exists(userRef())
        && get(userRef()).data.companyId == companyId;
    }

    function canAccessCompanyDoc(companyId) {
      return sameCompany(companyId) || canReadByCompanyDoc(companyId);
    }

    function canWriteCompanyDoc(companyId) {
      return canAccessCompanyDoc(companyId);
    }

    // -------------------------
    // users/{userId}
    // -------------------------
    match /users/{userId} {
      // Self read/write always allowed.
      allow read, create, update, delete: if isSignedIn() && request.auth.uid == userId;

      // Any user inside the same company can read member profiles.
      // This is required for company members list screen.
      allow read: if isSignedIn()
        && resource.data.companyId != null
        && canAccessCompanyDoc(resource.data.companyId);
    }

    // -------------------------
    // companies/{companyId}
    // -------------------------
    match /companies/{companyId} {
      // Onboarding create (including "default"): ownerId must be current user.
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;

      // IMPORTANT for first login:
      // allow reading company doc if user is owner, even before companyId appears in users/{uid}.
      allow read: if sameCompany(companyId) || isOwnerOfCompany(companyId);

      allow update, delete: if sameCompany(companyId) && isOwnerOrAdmin();
    }

    // -------------------------
    // tasks/{taskId}
    // -------------------------
    match /tasks/{taskId} {
      allow read: if sameCompanyDoc();
      allow create, update, delete: if sameCompanyRequest() && isOwnerOrAdmin();
    }

    // -------------------------
    // invites/{inviteId}
    // -------------------------
    match /invites/{inviteId} {
      // IMPORTANT:
      // join flow queries invites by code (whereField("code", isEqualTo: ...)).
      // Firestore rejects query if rules could deny any potential match.
      // To keep invite validation working reliably, allow read for signed-in users.
      allow read: if isSignedIn();

      // Only owner/admin of company can create/delete invites.
      allow create: if sameCompanyRequest() && isOwnerOrAdmin();
      allow delete: if sameCompanyDoc() && isOwnerOrAdmin();

      // Owner/admin can edit invite in same company.
      // Join-flow update: any signed-in user may mark invite as used once.
      // Kept intentionally permissive for compatibility with legacy invite documents.
      allow update: if (sameCompanyRequest() && isOwnerOrAdmin())
        || (
          isSignedIn()
          && resource.data.used != true
          && request.resource.data.used == true
        );
    }

    // -------------------------
    // Financial collections
    // -------------------------
    match /financialOperations/{operationId} {
      allow read: if canAccessCompanyDoc(resource.data.companyId);
      allow create: if canWriteFinancialForCompany(request.resource.data.companyId);
      allow update: if canWriteFinancialForCompany(resource.data.companyId)
        && request.resource.data.companyId == resource.data.companyId;
      allow delete: if canWriteFinancialForCompany(resource.data.companyId);
    }

    // Keep legacy collection with same restrictions as financialOperations.
    match /operations/{operationId} {
      allow read: if canAccessCompanyDoc(resource.data.companyId);
      allow create: if canWriteFinancialForCompany(request.resource.data.companyId);
      allow update: if canWriteFinancialForCompany(resource.data.companyId)
        && request.resource.data.companyId == resource.data.companyId;
      allow delete: if canWriteFinancialForCompany(resource.data.companyId);
    }

    match /accounts/{accountId} {
      allow read: if canAccessCompanyDoc(resource.data.companyId);
      allow create: if canWriteCompanyDoc(request.resource.data.companyId);
      allow update: if canWriteCompanyDoc(request.resource.data.companyId);
      allow delete: if canAccessCompanyDoc(resource.data.companyId);
    }

    // -------------------------
    // Catalog / Warehouse / Docs
    // -------------------------
    match /engines/{engineId} {
      allow read: if canAccessCompanyDoc(resource.data.companyId);
      allow create: if canWriteCompanyDoc(request.resource.data.companyId);
      allow update: if canWriteCompanyDoc(request.resource.data.companyId);
      allow delete: if canAccessCompanyDoc(resource.data.companyId);
    }

    match /motors/{motorId} {
      allow read: if canAccessCompanyDoc(resource.data.companyId);
      allow create: if canWriteCompanyDoc(request.resource.data.companyId);
      allow update: if canWriteCompanyDoc(request.resource.data.companyId);
      allow delete: if canAccessCompanyDoc(resource.data.companyId);
    }

    match /brands/{brandId} {
      allow read: if canAccessCompanyDoc(resource.data.companyId);
      allow create: if canWriteCompanyDoc(request.resource.data.companyId);
      allow update: if canWriteCompanyDoc(request.resource.data.companyId);
      allow delete: if canAccessCompanyDoc(resource.data.companyId);
    }

    match /inventoryItems/{itemId} {
      allow read: if canAccessCompanyDoc(resource.data.companyId);
      allow create: if canWriteCompanyDoc(request.resource.data.companyId);
      allow update: if canWriteCompanyDoc(request.resource.data.companyId);
      allow delete: if canAccessCompanyDoc(resource.data.companyId);
    }

    match /inventoryMovements/{movementId} {
      allow read: if canAccessCompanyDoc(resource.data.companyId);
      allow create: if canWriteCompanyDoc(request.resource.data.companyId);
      allow update: if canWriteCompanyDoc(request.resource.data.companyId);
      allow delete: if canAccessCompanyDoc(resource.data.companyId);
    }

    match /documents/{documentId} {
      allow read: if canAccessCompanyDoc(resource.data.companyId);
      allow create: if canWriteCompanyDoc(request.resource.data.companyId);
      allow update: if canWriteCompanyDoc(request.resource.data.companyId);
      allow delete: if canAccessCompanyDoc(resource.data.companyId);
    }

    // -------------------------
    // Audit log (append-only)
    // -------------------------
    match /auditLog/{logId} {
      allow read: if canAccessCompanyDoc(resource.data.companyId);
      allow create: if isSignedIn()
        && request.resource.data.companyId != null
        && canWriteCompanyDoc(request.resource.data.companyId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.timestamp is timestamp;
      allow update, delete: if false;
    }

    // -------------------------
    // Notifications
    // -------------------------
    match /notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && isOwnerOrAdmin()
        && request.resource.data.companyId == userCompanyId();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isOwnerOrAdmin());
    }

    // -------------------------
    // Default deny
    // -------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
